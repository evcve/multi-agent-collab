#!/bin/sh
# pre-push 上线门禁：pytest 全绿才允许 push（防漏洞代码上线）
# 大变更（>150 新增行）打印三方评审提醒（不阻止，评审是流程要求）
#
# 安装：git config core.hooksPath .githooks
set -u

# ── 1. 找可用的 pytest 解释器 ──
PYTEST_PY=""
for py in "C:/Program Files/Python313/python.exe" python python3 py; do
  if command -v "$py" >/dev/null 2>&1 || [ -x "$py" ]; then
    if "$py" -m pytest --version >/dev/null 2>&1; then
      PYTEST_PY="$py"
      break
    fi
  fi
done

if [ -z "$PYTEST_PY" ]; then
  echo "⚠️  pre-push: 未找到带 pytest 的 Python（跳过测试门禁，请手动验证）"
  exit 0
fi

echo "=== pre-push 门禁: pytest (via $PYTEST_PY) ==="
"$PYTEST_PY" -m pytest tests/ -q 2>&1 | tail -4
rc=${PIPESTATUS[0]}
if [ "$rc" -ne 0 ]; then
  echo "❌ pre-push: 测试未全绿（rc=$rc），push 已阻止。先修测试再推。"
  exit 1
fi
echo "✅ pre-push: 测试全绿，允许推送"

# ── 2. 大变更评审提醒 ──
ZERO="$(git hash-object --stdin </dev/null | tr '0' 'z')"
HEAD_SHA=$(git rev-parse --verify HEAD 2>/dev/null || echo "$ZERO")
REMOTE_BASE=$(git merge-base "$HEAD_SHA" "$(git rev-parse --abbrev-ref @{u} 2>/dev/null || echo "$HEAD_SHA")" 2>/dev/null || echo "$ZERO")
if [ -n "$REMOTE_BASE" ] && [ "$REMOTE_BASE" != "$HEAD_SHA" ]; then
  ADDED=$(git diff --numstat "$REMOTE_BASE".."$HEAD_SHA" 2>/dev/null | awk '{s+=$1} END {print s+0}')
  if [ "${ADDED:-0}" -gt 150 ]; then
    echo "⚠️  大变更提醒: 本次推送新增 ${ADDED} 行——按 CONTRIBUTING.md 应先过三方评审"
    echo "    scripts/review.py --diff-file <change.diff> --strict（Kimi + 智谱）"
  fi
fi
exit 0
